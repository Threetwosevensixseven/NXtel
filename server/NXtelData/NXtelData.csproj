<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>NXtelData</RootNamespace>
    <AssemblyName>NXtelData</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <!-- Manager-only code, not part of the server's build -->
  <ItemGroup>
    <Compile Remove="Classes\HelpItem.cs" />
    <Compile Remove="Classes\HelpItems.cs" />
    <Compile Remove="Classes\OptionsManager.cs" />
    <Compile Remove="Classes\ServerStatus.cs" />
    <Compile Remove="Classes\SQL.cs" />
  </ItemGroup>
</Project>
