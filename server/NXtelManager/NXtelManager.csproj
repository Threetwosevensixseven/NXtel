<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NXtelManager</RootNamespace>
    <AssemblyName>NXtelManager</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.23" />
    <PackageReference Include="MySqlBackup.NET.MySqlConnector" Version="2.7.1" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Markdown\Markdown.csproj" />
    <ProjectReference Include="..\NXtelData\NXtelData.csproj" />
  </ItemGroup>
  <!-- Manager-only code from NXtelData, not part of the server's build -->
  <ItemGroup>
    <Compile Include="..\NXtelData\Classes\HelpItem.cs" Link="NXtelData\HelpItem.cs" />
    <Compile Include="..\NXtelData\Classes\HelpItems.cs" Link="NXtelData\HelpItems.cs" />
    <Compile Include="..\NXtelData\Classes\SQL.cs" Link="NXtelData\SQL.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Content\**;Scripts\**;fonts\**;SiteHelp\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="Properties\PublishProfiles\**" />
  </ItemGroup>
</Project>
